{
  "name": "gharmai-kirana",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gharmai Kirana — online grocery store (Express + React SPA)",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "npm install --include=dev && npx prisma generate && npm --prefix client install --include=dev && npm --prefix client run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/platform.test.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "setup": "npm install && npm --prefix client install && npx prisma db push && npm run db:seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jose": "^6.2.9",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.9.1": true
  }
}
